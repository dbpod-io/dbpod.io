---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Disable default <main> scaffolding (homepage builds its own sections) */
  bare?: boolean;
}

const {
  title,
  description = 'dbpod — manage database engines and instances like Docker containers. Project-local, daemonless, cross-platform.',
  bare = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="dbpod" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0b0f14" />
  </head>
  <body>
    <header class="site-header">
      <nav class="container" aria-label="Main">
        <a href="/" class="brand" aria-label="dbpod home">dbpod<span class="cursor" aria-hidden="true"></span></a>
        <div class="nav-links">
          <a href="/docs/" class={Astro.url.pathname.startsWith('/docs') ? 'active' : ''}>Docs</a>
          <a href="https://github.com/dbpod-io/dbpod" target="_blank" rel="noopener noreferrer">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              ></path>
            </svg>
            GitHub
          </a>
        </div>
      </nav>
    </header>

    {
      bare ? (
        <slot />
      ) : (
        <main class="site-main container">
          <slot />
        </main>
      )
    }

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <span class="brand">dbpod<span class="cursor" aria-hidden="true"></span></span>
          <p>Databases, managed like containers.</p>
        </div>
        <nav class="footer-col" aria-label="Site">
          <h3>Site</h3>
          <a href="/">Home</a>
          <a href="/docs/">Documentation</a>
          <a href="/install.sh">install.sh</a>
        </nav>
        <nav class="footer-col" aria-label="Project">
          <h3>Project</h3>
          <a href="https://github.com/dbpod-io/dbpod" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a
            href="https://github.com/dbpod-io/dbpod/blob/main/LICENSE"
            target="_blank"
            rel="noopener noreferrer">License</a
          >
          <a href="https://github.com/dbpod-io/dbpod/issues" target="_blank" rel="noopener noreferrer">Issues</a>
        </nav>
        <div class="footer-col">
          <h3>Platforms</h3>
          <p class="platforms">macOS · Linux · Windows</p>
        </div>
      </div>
      <div class="container footer-base">
        <p>© {new Date().getFullYear()} dbpod.io</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
  }

  .site-header nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-height);
  }

  .brand {
    font-family: var(--mono);
    font-size: 1.1875rem;
    font-weight: 700;
    color: var(--text);
    display: inline-flex;
    align-items: center;
  }

  .brand:hover {
    text-decoration: none;
  }

  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 2px;
    background: var(--green);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-links a {
    font-family: var(--mono);
    font-size: 0.875rem;
    color: var(--text-dim);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: var(--text);
    text-decoration: none;
  }

  .nav-links a.active {
    color: var(--green);
  }

  .site-main {
    flex: 1;
  }

  /* --- footer --- */
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg-panel);
    margin-top: 4rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 2rem;
    padding-top: 3rem;
    padding-bottom: 2rem;
  }

  .footer-brand p {
    color: var(--text-dim);
    font-size: 0.9375rem;
    margin: 0.75rem 0 0;
  }

  .footer-col h3 {
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-faint);
    margin: 0 0 1rem;
  }

  .footer-col a,
  .footer-col p {
    display: block;
    color: var(--text-dim);
    font-size: 0.9375rem;
    margin-bottom: 0.625rem;
  }

  .footer-col a:hover {
    color: var(--text);
  }

  .footer-base {
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
  }

  .footer-base p {
    margin: 0;
    color: var(--text-faint);
    font-size: 0.8125rem;
    font-family: var(--mono);
  }

  @media (max-width: 48rem) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
