---
import BaseLayout from '../layouts/BaseLayout.astro';

const installCmd = 'curl -fsSL https://dbpod.io/install.sh | sh';

const quickstart = [
  { label: 'Install an engine', cmd: 'dbpod engine install mysql@8.0' },
  { label: 'Run an instance', cmd: 'dbpod run --name dev --engine mysql@8.0' },
  { label: 'Open a SQL shell', cmd: 'dbpod exec dev' },
];

const dockerMap = [
  {
    docker: 'image',
    dbpod: 'engine version',
    note: 'dbpod engine install mysql@8.0 — the series resolves to the latest known patch (8.0.46).',
  },
  {
    docker: 'container',
    dbpod: 'instance',
    note: 'dbpod run --name dev --engine mysql@8.0 — detached, ready when the prompt returns.',
  },
  {
    docker: 'volume',
    dbpod: 'project datadir',
    note: 'All state lives in ./.dbpod/ — data, logs, socket, pid. Delete the directory, the database is gone.',
  },
  {
    docker: 'docker images / rmi / pull',
    dbpod: 'same-named commands',
    note: 'Docker-compatible commands ship as hidden aliases. Docker users already know dbpod.',
  },
];

const features = [
  {
    title: 'Engines as images',
    tagline: 'Engine binaries as images. Install in seconds, run anywhere.',
    code: 'dbpod engine install postgres@17',
  },
  {
    title: 'Project-local data',
    tagline: 'Your data lives in your project. ./.dbpod is the whole story.',
    code: 'ls ./.dbpod/dev/',
  },
  {
    title: 'Managed runtime',
    tagline: 'Detached like a daemon, clean like a container.',
    code: 'dbpod run --rm --name ci --engine postgres@17',
  },
  {
    title: 'One-YAML extensibility',
    tagline: 'MySQL and PostgreSQL built in. MariaDB, Percona, MongoDB via one YAML file.',
    code: 'dbpod registry add ./mongodb.yaml',
  },
  {
    title: 'exec: the toolbox',
    tagline: 'Every binary in the distribution, one command away.',
    code: 'dbpod exec dev mysqldump --help',
  },
  {
    title: 'One binary, everywhere',
    tagline: 'One binary. macOS, Linux, Windows.',
    code: 'dbpod engine ls --all',
  },
];

const engines = [
  { name: 'MySQL', source: 'builtin', versions: '5.7 · 8.0 · 8.4 · 9.x' },
  { name: 'PostgreSQL', source: 'builtin', versions: '13 · 15 · 16 · 17' },
  { name: 'MariaDB', source: 'dbpod-ext', versions: 'via registry' },
  { name: 'Percona Server', source: 'dbpod-ext', versions: 'via registry' },
  { name: 'MongoDB', source: 'dbpod-ext', versions: 'via registry' },
];
---

<BaseLayout title="dbpod — Databases, managed like containers" bare>
  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="hero-eyebrow" data-hero>&lt;open-source database cli /&gt;</p>
      <h1 class="hero-title" data-hero>
        Databases, managed<br />
        like <span class="accent">containers</span><span class="hero-caret" aria-hidden="true"></span>
      </h1>
      <p class="hero-sub" data-hero>
        dbpod runs real MySQL &amp; PostgreSQL engines as project-local instances — installed like
        images, run detached, cleaned like containers. Zero global pollution.
      </p>

      <div class="install-box" data-hero>
        <div class="install-top">
          <div class="install-tabs" role="tablist" aria-label="Platform">
            <button class="os-tab is-active" data-os="unix" type="button" role="tab" aria-selected="true">
              macOS / Linux
            </button>
            <button class="os-tab" data-os="windows" type="button" role="tab" aria-selected="false">
              Windows
            </button>
          </div>
          <span class="install-hint">one-shot install</span>
        </div>

        <div class="install-row" id="rows-unix">
          <span class="dollar" aria-hidden="true">$</span>
          <code id="install-cmd-unix">{installCmd}</code>
          <button class="copy-btn" type="button" aria-label="Copy install command">copy</button>
        </div>

        <div id="rows-win" hidden>
          <div class="install-row">
            <span class="shell-tag">PowerShell</span>
            <code id="install-cmd-ps">irm https://dbpod.io/install.ps1 | iex</code>
            <button class="copy-btn" type="button" aria-label="Copy PowerShell install command">copy</button>
          </div>
          <div class="install-row">
            <span class="shell-tag">cmd</span>
            <code id="install-cmd-cmd">curl -fsSL https://dbpod.io/install.bat -o "%TEMP%\dbpod-install.bat" && call "%TEMP%\dbpod-install.bat"</code>
            <button class="copy-btn" type="button" aria-label="Copy cmd install command">copy</button>
          </div>
          <div class="install-row">
            <span class="shell-tag">WSL</span>
            <code id="install-cmd-wsl">{installCmd}</code>
            <button class="copy-btn" type="button" aria-label="Copy WSL install command">copy</button>
          </div>
        </div>
      </div>

      <!-- engine/version selection lives on /install/ -->
      <a class="builder-link" href="/install/">
        want a database preinstalled? build the one-shot command <span aria-hidden="true">→</span>
      </a>

      <ol class="quickstart" data-hero>
        {
          quickstart.map((step, i) => (
            <li>
              <span class="qs-label">
                <span class="qs-num">{i + 1}</span>
                {step.label}
              </span>
              <code class="qs-cmd">
                <span class="dollar">$</span> {step.cmd}
              </code>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ================= TERMINAL DEMO ================= -->
  <section class="section demo">
    <div class="container">
      <div class="term" data-reveal>
        <div class="term-bar">
          <span class="term-dot" aria-hidden="true"></span>
          <span class="term-dot" aria-hidden="true"></span>
          <span class="term-dot" aria-hidden="true"></span>
          <span class="term-title">dbpod — zsh</span>
          <button class="term-replay" id="term-replay" type="button" hidden>↻ replay</button>
        </div>
        <div class="term-body" id="term-body" aria-live="polite"></div>
      </div>
      <p class="demo-note" data-reveal>
        Full lifecycle: install → run → query → inspect → stop. Re-recordable with <code>vhs</code>; scripted in-repo.
      </p>
    </div>
  </section>

  <!-- ================= DOCKER MENTAL MODEL ================= -->
  <section class="section">
    <div class="container">
      <p class="section-eyebrow" data-reveal>mental model</p>
      <h2 class="section-title" data-reveal>If you know Docker, you know dbpod.</h2>
      <p class="section-lead" data-reveal>
        Every concept maps one-to-one. No new vocabulary, no new workflow.
      </p>

      <div class="map-table" data-reveal>
        <div class="map-head" aria-hidden="true">
          <span>Docker</span>
          <span>dbpod</span>
          <span class="map-note-head">what it means</span>
        </div>
        {
          dockerMap.map((row) => (
            <div class="map-row">
              <span class="map-docker">
                <code>{row.docker}</code>
              </span>
              <span class="map-dbpod">
                <code>{row.dbpod}</code>
              </span>
              <span class="map-note">{row.note}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= CAPABILITY GRID ================= -->
  <section class="section">
    <div class="container">
      <p class="section-eyebrow" data-reveal>capabilities</p>
      <h2 class="section-title" data-reveal>Built lightweight, on purpose.</h2>
      <p class="section-lead" data-reveal>
        One static binary. No system services, no /usr/local litter, no root.
      </p>

      <div class="feature-grid">
        {
          features.map((f) => (
            <article class="feature-card" data-reveal>
              <h3>{f.title}</h3>
              <p>{f.tagline}</p>
              <code class="feature-code">
                <span class="dollar" aria-hidden="true">$</span>
                {f.code}
              </code>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= ENGINES ================= -->
  <section class="section">
    <div class="container">
      <p class="section-eyebrow" data-reveal>engines</p>
      <h2 class="section-title" data-reveal>Two engines built in. More are one YAML away.</h2>
      <p class="section-lead" data-reveal>
        Builtin engines ship with the binary. Community engines come from the
        <code class="inline-code">dbpod-ext</code> registry — adding one touches zero lines of main
        code. <a href="/docs/extend/">How extending works →</a>
      </p>

      <ul class="engine-list" data-reveal>
        {
          engines.map((e) => (
            <li class="engine-item">
              <span class="engine-name">{e.name}</span>
              <span class:list={['engine-src', e.source === 'builtin' ? 'is-builtin' : 'is-ext']}>
                {e.source}
              </span>
              <span class="engine-versions">{e.versions}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ================= GITHUB CTA ================= -->
  <section class="section cta">
    <div class="container cta-inner" data-reveal>
      <h2 class="section-title">Developed in the open.</h2>
      <p class="section-lead">
        Read the source, file issues, or add your own engine. Start in under a minute:
      </p>
      <div class="cta-actions">
        <a
          class="btn btn-primary"
          href="https://github.com/dbpod-io/dbpod"
          target="_blank"
          rel="noopener noreferrer">Star on GitHub</a
        >
        <a class="btn btn-ghost" href="/docs/">Read the docs</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ================= HERO ================= */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 6rem 0 5rem;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(ellipse 90% 70% at 50% -10%, black 25%, transparent 78%);
    -webkit-mask-image: radial-gradient(ellipse 90% 70% at 50% -10%, black 25%, transparent 78%);
    pointer-events: none;
  }

  .hero-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 55% 45% at 50% -5%,
      rgba(60, 224, 143, 0.14),
      transparent 70%
    );
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-eyebrow {
    font-family: var(--mono);
    font-size: 0.875rem;
    color: var(--green);
    margin: 0 0 1.25rem;
  }

  .hero-title {
    font-family: var(--mono);
    font-size: clamp(2.25rem, 6.5vw, 4.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0;
    line-height: 1.08;
  }

  .accent {
    color: var(--green);
    text-shadow: 0 0 24px rgba(60, 224, 143, 0.45);
  }

  .hero-caret {
    display: inline-block;
    width: 0.5em;
    height: 0.9em;
    margin-left: 0.1em;
    background: var(--green);
    vertical-align: baseline;
    animation: blink 1.1s steps(1) infinite;
  }

  .hero-sub {
    max-width: 40rem;
    color: var(--text-dim);
    font-size: 1.125rem;
    margin: 1.5rem 0 0;
  }

  .install-box {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-top: 2.25rem;
    padding: 0.875rem 1.25rem;
    background: var(--bg-code);
    border: 1px solid var(--border-strong);
    border-radius: 0.5rem;
    font-family: var(--mono);
    /* fixed width so platform switches don't resize the box */
    width: min(100%, 44rem);
  }

  .install-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .install-tabs {
    display: inline-flex;
    gap: 0.25rem;
    background: var(--bg-raise);
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    padding: 0.1875rem;
  }

  .os-tab {
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
    background: transparent;
    border: none;
    border-radius: 0.25rem;
    padding: 0.25rem 0.75rem;
    cursor: pointer;
    transition:
      color 0.15s ease,
      background 0.15s ease;
  }

  .os-tab:hover {
    color: var(--text-dim);
  }

  .os-tab.is-active {
    color: var(--green);
    background: var(--bg-code);
  }

  .install-hint {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-faint);
  }

  .install-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: clamp(0.8125rem, 2.5vw, 1rem);
  }

  .install-row code {
    color: var(--text);
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
    flex: 1;
    text-align: left;
  }

  /* display:flex on .install-row would defeat the hidden attribute */
  #rows-unix[hidden] {
    display: none;
  }

  #rows-win .install-row + .install-row {
    margin-top: 0.625rem;
  }

  .shell-tag {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--cyan);
    min-width: 5.25rem;
    text-align: right;
    flex-shrink: 0;
  }

  .builder-link {
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--text-faint);
    margin-top: 0.875rem;
    transition: color 0.15s ease;
  }

  .builder-link:hover {
    color: var(--green);
  }

  .builder-link span {
    color: var(--green);
  }

  .dollar {
    color: var(--green);
    user-select: none;
  }

  .copy-btn {
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    background: transparent;
    border: 1px solid var(--border-strong);
    border-radius: 0.25rem;
    padding: 0.25rem 0.625rem;
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .copy-btn:hover,
  .copy-btn.copied {
    color: var(--green);
    border-color: var(--green);
  }

  .quickstart {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 2.5rem;
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0;
  }

  .quickstart li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.375rem;
  }

  .qs-label {
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-faint);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .qs-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    border: 1px solid var(--green);
    border-radius: 50%;
    color: var(--green);
    font-size: 0.6875rem;
  }

  .qs-cmd {
    font-size: 0.875rem;
    color: var(--text-dim);
  }

  .qs-cmd .dollar {
    margin-right: 0.25rem;
  }

  /* ================= TERMINAL ================= */
  .demo {
    padding-top: 3rem;
  }

  .term {
    max-width: 46rem;
    margin: 0 auto;
    background: var(--bg-code);
    border: 1px solid var(--border-strong);
    border-radius: 0.75rem;
    box-shadow:
      0 0 0 1px rgba(60, 224, 143, 0.05),
      0 24px 64px rgba(0, 0, 0, 0.5),
      0 0 80px rgba(60, 224, 143, 0.06);
    overflow: hidden;
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: var(--bg-raise);
    border-bottom: 1px solid var(--border);
  }

  .term-dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--border-strong);
  }

  .term-dot:first-child {
    background: #ff5f57;
  }

  .term-dot:nth-child(2) {
    background: #febc2e;
  }

  .term-dot:nth-child(3) {
    background: #28c840;
  }

  .term-title {
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--text-faint);
    margin-left: 0.5rem;
  }

  .term-replay {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--text-dim);
    background: transparent;
    border: 1px solid var(--border-strong);
    border-radius: 0.25rem;
    padding: 0.1875rem 0.5rem;
    cursor: pointer;
  }

  .term-replay:hover {
    color: var(--green);
    border-color: var(--green);
  }

  .term-body {
    font-family: var(--mono);
    font-size: clamp(0.8125rem, 2vw, 0.9375rem);
    line-height: 1.7;
    padding: 1.25rem 1.5rem 1.5rem;
    min-height: 21em;
    white-space: pre-wrap;
    word-break: break-all;
  }

  .term-body .t-prompt {
    color: var(--green);
    font-weight: 700;
  }

  .term-body .t-cmd {
    color: var(--text);
  }

  .term-body .t-out {
    color: var(--text-dim);
  }

  .term-body .t-ok {
    color: var(--green);
  }

  .term-body .t-cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    background: var(--green);
    vertical-align: text-bottom;
    animation: blink 1s steps(1) infinite;
  }

  .demo-note {
    text-align: center;
    color: var(--text-faint);
    font-family: var(--mono);
    font-size: 0.8125rem;
    margin: 1.5rem auto 0;
  }

  .demo-note code {
    color: var(--text-dim);
  }

  /* ================= DOCKER MAP ================= */
  .map-table {
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    overflow: hidden;
    background: var(--bg-panel);
  }

  .map-head,
  .map-row {
    display: grid;
    grid-template-columns: minmax(10rem, 1fr) minmax(10rem, 1fr) 2fr;
    gap: 1.5rem;
    align-items: center;
    padding: 1rem 1.5rem;
  }

  .map-head {
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-faint);
    background: var(--bg-raise);
    border-bottom: 1px solid var(--border);
  }

  .map-row + .map-row {
    border-top: 1px solid var(--border);
  }

  .map-docker code {
    color: var(--cyan);
    font-size: 0.9375rem;
  }

  .map-dbpod code {
    color: var(--green);
    font-size: 0.9375rem;
  }

  .map-note {
    color: var(--text-dim);
    font-size: 0.9375rem;
  }

  /* ================= FEATURE GRID ================= */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: 1.25rem;
  }

  .feature-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-panel);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 1.5rem;
    transition: border-color 0.2s ease;
  }

  .feature-card:hover {
    border-color: var(--border-strong);
  }

  .feature-card h3 {
    font-family: var(--mono);
    font-size: 1.0625rem;
    margin: 0 0 0.5rem;
  }

  .feature-card h3::before {
    content: '> ';
    color: var(--green);
  }

  .feature-card p {
    color: var(--text-dim);
    font-size: 0.9375rem;
    margin: 0 0 1.25rem;
    flex: 1;
  }

  .feature-code {
    font-size: 0.8125rem;
    color: var(--text);
    background: var(--bg-code);
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    padding: 0.5rem 0.75rem;
    overflow-x: auto;
    white-space: nowrap;
  }

  .feature-code .dollar {
    margin-right: 0.375rem;
  }

  /* ================= ENGINES ================= */
  .engine-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    overflow: hidden;
    background: var(--bg-panel);
  }

  .engine-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
  }

  .engine-item + .engine-item {
    border-top: 1px solid var(--border);
  }

  .engine-name {
    font-family: var(--mono);
    font-weight: 600;
    min-width: 9rem;
  }

  .engine-src {
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 999px;
    padding: 0.125rem 0.625rem;
  }

  .engine-src.is-builtin {
    color: var(--green);
    background: var(--green-soft);
  }

  .engine-src.is-ext {
    color: var(--amber);
    background: rgba(255, 180, 84, 0.12);
  }

  .engine-versions {
    margin-left: auto;
    color: var(--text-faint);
    font-family: var(--mono);
    font-size: 0.8125rem;
  }

  /* ================= CTA ================= */
  .cta {
    border-bottom: 1px solid var(--border);
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .inline-code {
    font-size: 0.875em;
    color: var(--amber);
    background: var(--bg-code);
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    padding: 0.1em 0.4em;
  }

  /* ================= RESPONSIVE ================= */
  @media (max-width: 56rem) {
    .map-head {
      display: none;
    }

    .map-row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
      padding: 1rem 1.25rem;
    }

    .map-note {
      margin-top: 0.25rem;
    }
  }

  @media (max-width: 40rem) {
    .hero {
      padding-top: 4rem;
    }

    .engine-versions {
      display: none;
    }

    .install-hint {
      display: none;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  /* ---------------------------------------------------------------
   * Terminal script — the lifecycle story from the plan:
   * engine install → run → exec → ps → stop
   * ---------------------------------------------------------------- */
  type TermStep =
    | { kind: 'cmd'; text: string }
    | { kind: 'out'; lines: string[] };

  const TERM_SCRIPT: TermStep[] = [
    { kind: 'cmd', text: 'dbpod engine install mysql@8.0' },
    {
      kind: 'out',
      lines: ['<span class="t-ok">✓</span> resolved <span class="t-ok">mysql@8.0 → 8.0.46</span>', '✓ installed → ~/.dbpod/versions/mysql/8.0.46  (2.1s)'],
    },
    { kind: 'cmd', text: 'dbpod run --name dev --engine mysql@8.0' },
    {
      kind: 'out',
      lines: ['<span class="t-ok">✓</span> dev is ready → 127.0.0.1:3306 · datadir ./.dbpod/dev'],
    },
    { kind: 'cmd', text: 'dbpod exec dev -e "SELECT 1"' },
    {
      kind: 'out',
      lines: ['+---+', '| 1 |', '+---+', '| 1 |', '+---+'],
    },
    { kind: 'cmd', text: 'dbpod ps' },
    {
      kind: 'out',
      lines: ['NAME  ENGINE     STATUS   PORTS', 'dev   mysql@8.0  running  3306'],
    },
    { kind: 'cmd', text: 'dbpod stop dev' },
    { kind: 'out', lines: ['<span class="t-ok">✓</span> dev stopped (graceful)'] },
  ];

  const body = document.getElementById('term-body')!;
  const replayBtn = document.getElementById('term-replay')!;

  const CHAR_MS = 28; // per-character typing speed
  let cursor: HTMLSpanElement | null = null;

  function ensureCursor(line: HTMLDivElement) {
    if (!cursor) {
      cursor = document.createElement('span');
      cursor.className = 't-cursor';
    }
    line.appendChild(cursor);
  }

  function renderStatic() {
    // Final state, no animation (used for prefers-reduced-motion)
    const frag = document.createDocumentFragment();
    for (const step of TERM_SCRIPT) {
      if (step.kind === 'cmd') {
        const line = document.createElement('div');
        line.innerHTML = `<span class="t-prompt">$ </span><span class="t-cmd">${step.text}</span>`;
        frag.appendChild(line);
      } else {
        for (const l of step.lines) {
          const line = document.createElement('div');
          line.className = 't-out';
          line.innerHTML = l;
          frag.appendChild(line);
        }
      }
    }
    body.replaceChildren(frag);
    replayBtn.hidden = true;
  }

  function buildTimeline() {
    const tl = gsap.timeline({
      paused: true,
      onRestart: () => {
        body.replaceChildren();
        cursor = null;
      },
    });

    for (const step of TERM_SCRIPT) {
      if (step.kind === 'cmd') {
        // Create the line at build time, attach it when the playhead reaches it.
        const line = document.createElement('div');
        line.innerHTML = `<span class="t-prompt">$ </span><span class="t-cmd"></span>`;
        tl.call(() => {
          ensureCursor(line);
          body.appendChild(line);
        });
        tl.to(
          { chars: 0 },
          {
            chars: step.text.length,
            duration: (step.text.length * CHAR_MS) / 1000,
            ease: 'none',
            onUpdate() {
              const target = this.targets()[0] as { chars: number };
              const cmdSpan = line.querySelector<HTMLElement>('.t-cmd');
              if (cmdSpan) cmdSpan.textContent = step.text.slice(0, Math.floor(target.chars));
            },
          },
        );
        tl.to({}, { duration: 0.25 }); // beat before output
      } else {
        for (const l of step.lines) {
          const line = document.createElement('div');
          line.className = 't-out';
          line.innerHTML = l;
          tl.call(() => {
            ensureCursor(line);
            body.appendChild(line);
          });
          tl.from(line, { autoAlpha: 0, y: 3, duration: 0.18, ease: 'power1.out' });
        }
        tl.to({}, { duration: 0.15 });
      }
    }

    tl.call(() => {
      replayBtn.hidden = false;
    });

    return tl;
  }

  /* ---------------------------------------------------------------
   * Motion setup — honors prefers-reduced-motion via gsap.matchMedia
   * ---------------------------------------------------------------- */
  const mm = gsap.matchMedia();

  mm.add(
    {
      motionOK: '(prefers-reduced-motion: no-preference)',
      reduced: '(prefers-reduced-motion: reduce)',
    },
    (ctx) => {
      const { motionOK, reduced } = ctx.conditions;

      if (reduced || !motionOK) {
        renderStatic();
        // Reveal everything instantly, no animation
        gsap.set('[data-hero], [data-reveal]', { clearProps: 'all' });
        return;
      }

      /* Hero entrance timeline */
      gsap
        .timeline({ defaults: { ease: 'power3.out', duration: 0.7 } })
        .from('[data-hero]', { y: 26, autoAlpha: 0, stagger: 0.12 }, 0.15);

      /* Terminal: type on first scroll into view */
      const termTl = buildTimeline();
      ScrollTrigger.create({
        trigger: '.term',
        start: 'top 75%',
        once: true,
        onEnter: () => termTl.play(),
      });

      replayBtn.addEventListener('click', () => termTl.restart());

      /* Section reveals */
      gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
        gsap.from(el, {
          y: 28,
          autoAlpha: 0,
          duration: 0.7,
          ease: 'power3.out',
          scrollTrigger: { trigger: el, start: 'top 85%', once: true },
        });
      });
    },
  );

  /* ---------------------------------------------------------------
   * Install command builder — OS tabs + engine selector
   * ---------------------------------------------------------------- */
  const codeEls = {
    unix: document.getElementById('install-cmd-unix')!,
    ps: document.getElementById('install-cmd-ps')!,
    cmd: document.getElementById('install-cmd-cmd')!,
    wsl: document.getElementById('install-cmd-wsl')!,
  };
  const rowsUnix = document.getElementById('rows-unix')!;
  const rowsWin = document.getElementById('rows-win')!;
  const osTabs = [...document.querySelectorAll<HTMLButtonElement>('.os-tab')];

  type Os = 'unix' | 'windows';
  const os: Os = /Win/i.test(navigator.userAgent) ? 'windows' : 'unix';

  function setActiveTab(active: HTMLButtonElement) {
    for (const tab of osTabs) {
      const on = tab === active;
      tab.classList.toggle('is-active', on);
      tab.setAttribute('aria-selected', String(on));
    }
  }

  function renderInstallCmd(selected: Os) {
    const unix = 'curl -fsSL https://dbpod.io/install.sh | sh';
    codeEls.unix.textContent = unix;
    codeEls.wsl.textContent = unix; // WSL is Linux — same installer as macOS/Linux
    codeEls.ps.textContent = 'irm https://dbpod.io/install.ps1 | iex';
    codeEls.cmd.textContent =
      'curl -fsSL https://dbpod.io/install.bat -o "%TEMP%\\dbpod-install.bat" && call "%TEMP%\\dbpod-install.bat"';
    rowsUnix.hidden = selected !== 'unix';
    rowsWin.hidden = selected !== 'windows';
  }

  const activeTab = osTabs.find((t) => t.dataset.os === os) ?? osTabs[0];
  setActiveTab(activeTab);
  renderInstallCmd((activeTab.dataset.os as Os) ?? 'unix');

  for (const tab of osTabs) {
    tab.addEventListener('click', () => {
      setActiveTab(tab);
      renderInstallCmd(tab.dataset.os as Os);
    });
  }

  /* ---------------------------------------------------------------
   * Copy install command — every copy button copies its row's code
   * ---------------------------------------------------------------- */
  for (const copyBtn of document.querySelectorAll<HTMLButtonElement>('.install-box .copy-btn')) {
    copyBtn.addEventListener('click', async () => {
      const code = copyBtn.parentElement?.querySelector('code');
      if (!code) return;
      try {
        await navigator.clipboard.writeText(code.textContent ?? '');
        copyBtn.textContent = 'copied';
        copyBtn.classList.add('copied');
        setTimeout(() => {
          copyBtn.textContent = 'copy';
          copyBtn.classList.remove('copied');
        }, 1600);
      } catch {
        // clipboard unavailable (e.g. http) — leave the command selectable
      }
    });
  }
</script>
